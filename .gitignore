# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored: only the Python install artifact at repo root (lib64 likewise), so
# frontend/src/lib/ (shadcn helpers) isn't accidentally ignored.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Lockfile: requirements.txt is the single source of truth (CI installs via
# pip). uv.lock is a local-only artifact some developers generate; never
# commit it — it would create a second, drift-prone source of truth.
uv.lock

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & coverage
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/
htmlcov/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Environment & secrets
.env
.env.local
.env.*.local

# Node.js
# node_modules/ is the install artifact of `npm install` (frontend/ + any
# tooling at repo root). Never commit — it is regenerated from package-lock.json
# and would bloat the repo / cause cross-platform churn. Covers both repo-root
# and frontend/node_modules.
node_modules/

# Logs
*.log
logs/

# Docker
docker-compose.override.yml

# Distribution / packaging
*.tar.gz
*.whl

# Local DB
*.sqlite3
*.db

# Uploaded files (created at runtime by LocalStorage under repo root when
# storage_backend == "local"; S3/OSS backends don't write here). Never commit.
uploads/

# Local tooling state (CLI agents / Apifox local cache)
.zcode/
.apifox/

# Skill usage counters (local-only, generated by scripts/skill-counter.sh hook)
# Each developer's own usage stats — never commit. The script itself is tracked.
.skill-counters.json
.skill-counters.log

.toco
.vscode/toco*
.idea/toco*